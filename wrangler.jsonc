{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leptitresto29",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  // Remplacer les deux identifiants ci-dessous par ceux affichés par
  // « npx wrangler d1 create leptitresto29 » et « npx wrangler kv namespace create MEDIA » (voir README).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "leptitresto29",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "MEDIA", "id": "00000000000000000000000000000000" }
  ],
  "observability": { "enabled": true }
}
