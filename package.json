{
  "name": "leptitresto29",
  "private": true,
  "type": "module",
  "description": "Site du P'tit Resto 29 : carte, click & collect, réservations et administration (Cloudflare Workers + D1 + KV).",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply leptitresto29 --local",
